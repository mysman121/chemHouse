{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chemhouse",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": { "DEEPSEEK_MODEL": "deepseek-flash" },
  "ratelimits": [{
    "name": "AI_RATE_LIMITER",
    "namespace_id": "72641001",
    "simple": { "limit": 10, "period": 60 }
  }]
}

